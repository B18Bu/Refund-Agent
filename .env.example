# =====================================================================
# 客诉舆情退赔决策系统 —— 环境变量模板（MVP）
# 复制为 .env 后按实际环境填写；生产环境请改用 Secret 管理，勿提交真实密钥。
# =====================================================================

# ===== 应用 =====
ENVIRONMENT=development          # development | testing | production
LOG_LEVEL=INFO

# ===== LLM（DeepSeek，OpenAI 兼容接口）=====
# LLM_PROVIDER: deepseek | mock   （mock 为本地确定性 Stub，无需密钥）
# 本地默认使用确定性 Mock，确保无外部密钥时 128 元低风险订单可自动退赔；生产环境显式改为 deepseek
LLM_PROVIDER=mock
DEEPSEEK_API_KEY= # 必填：DeepSeek API Key（platform.deepseek.com），请通过本地环境变量注入
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ===== OCR（本地 PaddleOCR 推理引擎）=====
# 首启自动下载 PP-OCRv4 中文模型（约 20MB），离线推理
OCR_DEVICE=cpu                   # cpu | gpu
OCR_LANG=ch
OCR_USE_ANGLE_CLS=true
OCR_CONFIDENCE_THRESHOLD=0.60

# ===== 决策阈值 =====
AUTO_REFUND_MAX_AMOUNT=300.0
FRAUD_SCORE_THRESHOLD=50

# ===== 认证 =====
JWT_SECRET=change-me-to-a-long-secret-in-production   # 至少 32 字符
JWT_EXPIRES_MINUTES=120

# ===== 存储 =====
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/refund
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=data/uploads
MAX_UPLOAD_FILES=3
MAX_UPLOAD_SIZE_MB=10

# ===== Redis Streams =====
STREAM_KEY=stream:tickets
CONSUMER_GROUP=worker-group

# ===== LangGraph Checkpointer =====
# postgres（默认，零额外依赖） | redis（需 RedisJSON 模块）
CHECKPOINTER_BACKEND=postgres

# ===== Agent 评测 / 观测 / 沙箱 =====
# 默认关闭外部 Telemetry，避免开发环境泄露业务数据或阻塞主流程
TELEMETRY_ENABLED=false
TELEMETRY_PROVIDER=noop       # noop | langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
PROMPT_VERSION=refund-v1
SANDBOX_PROVIDER=disabled     # disabled | docker | cube
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_CONCURRENCY=4
CUBESANDBOX_API_URL=http://127.0.0.1:3000
CUBESANDBOX_API_KEY=
CUBESANDBOX_TEMPLATE_ID=
CUBESANDBOX_PROXY_NODE_IP=
CUBESANDBOX_PROXY_PORT=8080
